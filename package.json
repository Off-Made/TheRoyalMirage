{
  "name": "the-royal-mirage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Royal Mirage - Casino in stile Las Vegas. Slot, blackjack, roulette, baccarat, video poker e Neon Rocket. Gioco di simulazione con euro virtuali.",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "preview:lan": "vite build && vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pixi/sound": "^6.0.1",
    "gsap": "^3.15.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "puppeteer-core": "^25.16.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
